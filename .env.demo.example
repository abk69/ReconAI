# Demo profile for a single-operator portfolio checkout.
# Copy to .env before the first `docker compose up` on a new database volume.
# This password is a local sample, not a production secret. It is not the local default account.

APP_NAME=reconai
APP_ENV=demo
DEBUG=false
API_PREFIX=

CORS_ORIGINS=http://localhost:3000

POSTGRES_USER=reconai
POSTGRES_PASSWORD=demo-portfolio-db
POSTGRES_DB=reconai
DATABASE_URL=postgresql+psycopg://reconai:demo-portfolio-db@localhost:5432/reconai

QUANTITY_TOLERANCE=0
PRICE_TOLERANCE_PERCENT=0
TAX_RATE_TOLERANCE_PERCENT=0

STORAGE_ROOT=storage/documents
MAX_UPLOAD_BYTES=10485760

# Optional. Leave empty to run deterministic demo features without Gemini.
# The frontend never receives this value.
GEMINI_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=45
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=1
LLM_QUALITY_THRESHOLD=READY_FOR_RECONCILIATION

POLICY_CHUNK_MAX_CHARS=2000
MAX_POLICY_UPLOAD_BYTES=10485760

EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

POLICY_GROUNDING_TOP_K=5
POLICY_RETRIEVAL_MIN_SIMILARITY=0.25
