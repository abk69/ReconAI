# ReconAI local environment example
# Copy to .env and adjust as needed.

APP_NAME=reconai
# local allows debug and the Compose database account.
# demo and production force debug off and reject that account.
APP_ENV=local
DEBUG=true
API_PREFIX=

# Browser origins allowed to call this API. Not a secret.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL SQLAlchemy URL (psycopg v3 driver). Local default matches docker-compose.yml.
# Compose reads POSTGRES_* from this file when it is copied to .env.
# These values are the local development account. Do not use them with APP_ENV=demo.
# For the demo profile, copy .env.demo.example instead.
POSTGRES_USER=reconai
POSTGRES_PASSWORD=reconai
POSTGRES_DB=reconai
DATABASE_URL=postgresql+psycopg://reconai:reconai@localhost:5432/reconai

# Reconciliation tolerances (optional; defaults are exact match)
QUANTITY_TOLERANCE=0
PRICE_TOLERANCE_PERCENT=0
TAX_RATE_TOLERANCE_PERCENT=0

# Document intake (M3)
STORAGE_ROOT=storage/documents
MAX_UPLOAD_BYTES=10485760

# LLM-assisted extraction (M6) — optional. Deterministic paths run without it.
# Do not commit a real key. Copy to .env locally.
GEMINI_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=45
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_RETRIES=1
LLM_QUALITY_THRESHOLD=READY_FOR_RECONCILIATION

# Policy ingestion / chunking (M7.2)
POLICY_CHUNK_MAX_CHARS=2000
MAX_POLICY_UPLOAD_BYTES=10485760

# Policy embeddings / retrieval (M7.3) — pgvector on PostgreSQL
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Policy grounded reasoning (M7.4)
POLICY_GROUNDING_TOP_K=5
POLICY_RETRIEVAL_MIN_SIMILARITY=0.25
